    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/ruslan-display": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "immer": "^10.2.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
