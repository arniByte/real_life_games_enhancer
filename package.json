{
  "name": "real-life-games-enhancer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real Life Games Enhancer — roguelike/gacha companion for real-life games (darts, chess, cards, ping-pong, anything) in a dark PS1 style.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
